# syntax=docker/dockerfile:1
FROM swift:6.2-jammy AS build
WORKDIR /build

RUN git config --global --add safe.directory '*'
ENV GIT_TERMINAL_PROMPT=0

COPY services/mcp-gateway/Package.swift services/mcp-gateway/Package.resolved ./
RUN swift package resolve

COPY services/mcp-gateway/Sources ./Sources
COPY services/mcp-gateway/Tests ./Tests
RUN swift build -c release --product App \
    && install -m 0755 /build/.build/release/App /build/App

FROM swift:6.2-jammy
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /build/App /app/App
EXPOSE 8080
ENV HOST=0.0.0.0
CMD ["/bin/sh", "-c", "exec /app/App serve --bind ${HOST:-0.0.0.0}:${PORT:-8080}"]
